{
  "name": "clitafl",
  "version": "2.7.1",
  "description": "The ultimate Tafl game: six historical Viking board games (tablut, copenhagen, brandub, ard-ri, alea evangelii, tawlbwrdd) from 7x7 to 19x19, with a transposition-table search AI and an opening book, in the terminal, in the browser, and over an HTTP API that pushes every move to agents and watchers.",
  "main": "src/index.js",
  "bin": {
    "clitafl": "./src/index.js",
    "tafl": "./src/index.js"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "start": "node src/index.js play",
    "demo": "node src/index.js demo",
    "match": "node src/index.js match",
    "serve": "node src/index.js serve",
    "variants": "node src/index.js variants",
    "book": "node tools/make-book.js"
  },
  "keywords": [
    "tafl",
    "hnefatafl",
    "tablut",
    "brandub",
    "viking",
    "board-game",
    "cli",
    "game",
    "strategy",
    "ai",
    "negamax",
    "web-game",
    "http-api",
    "node"
  ],
  "author": "William Gacquer",
